name: aaykra
title: AAYKRA
base: core24
version: "$RELEASE_VERSION"
summary: The editor that doesn't get in your way
description: |
  AAYKRA is a fast, native code editor built in Rust with a GPU-accelerated
  renderer. It pairs the speed of a native app with the familiarity of
  VS Code and stays out of your way.
grade: stable
confinement: classic
compression: lzo
website: https://aayushhpokhrel.com.np
source-code: https://github.com/aayushpokhrel49/Aaykra
issues: https://github.com/aayushpokhrel49/Aaykra/issues
contact: mailto:info@aayushhpokhrel.com.np

parts:
  aaykra:
    plugin: dump
    source: "https://github.com/aayushpokhrel49/Aaykra/releases/download/v$RELEASE_VERSION/aaykra-linux-x86_64.tar.gz"

    organize:
      # These renames seem to not be necessary, but it's tidier.
      bin: usr/bin
      libexec: usr/libexec

    stage-packages:
      - libasound2t64
      # snapcraft has a lint that this is unused, but without it AAYKRA exits with
      # "Missing Vulkan entry points: LibraryLoadFailure" in wgpu.
      - libvulkan1
      # snapcraft has a lint that this is unused, but without it AAYKRA exits with
      # "NoWaylandLib" when run with Wayland.
      - libwayland-client0
      - libxcb1
      - libxkbcommon-x11-0
      - libxkbcommon0

    build-attributes:
      - enable-patchelf

    prime:
      # Omit unneeded files from the tarball
      - -lib
      - -licenses.md
      - -share

      # Omit unneeded files from stage-packages
      - -etc
      - -usr/share/doc
      - -usr/share/lintian
      - -usr/share/man

apps:
  aaykra:
    command: usr/bin/aaykra
    common-id: me.aayush.Aaykra
    environment:
      ZED_BUNDLE_TYPE: snap

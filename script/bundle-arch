#!/usr/bin/env bash

set -euxo pipefail

help_info() {
  echo "
Usage: ${0##*/} [options]
Build a release .pkg.tar.zst for Arch Linux.

Options:
  -h, --help     Display this help and exit.
  "
}

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            help_info
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Unknown option: $1" >&2
            help_info
            exit 1
            ;;
        *)
            echo "Error: Unexpected argument: $1" >&2
            help_info
            exit 1
            ;;
    esac
done

export ZED_BUNDLE=true

target_dir="${CARGO_TARGET_DIR:-target}"

channel=$(<crates/aaykra/RELEASE_CHANNEL)
version="$(script/get-crate-version aaykra)"
export RELEASE_VERSION="${version}"

export CC="${CC:-$(command -v clang)}"

# The .pkg.tar.zst is published straight from GitHub Releases, so it uses the
# same GitHub self-updater as the tar.gz build: it checks the releases API,
# downloads `aaykra-linux-<arch>.tar.gz`, and applies it in place. When the
# app is installed to a root-owned location like /opt (which pacman owns and the
# updater cannot write to without privileges), the update lands as a per-user
# copy under ~/.local and the app restarts from there.

script/generate-licenses || true

arch=$(uname -m)
if [[ "$arch" == "x86_64" ]]; then
    pkg_arch="x86_64"
elif [[ "$arch" == "aarch64" ]]; then
    pkg_arch="aarch64"
else
    echo "Unsupported architecture: $arch" >&2
    exit 1
fi

cargo build --release --package aaykra --package cli

llvm-objcopy --strip-debug "${target_dir}/release/aaykra"
llvm-objcopy --strip-debug "${target_dir}/release/cli"

suffix=""
if [ "$channel" != "stable" ]; then
    suffix="-$channel"
fi

package_name="aaykra${suffix}"
pkgrel="1"

package_root="$(mktemp -d)"
install_dir="${package_root}/opt/aaykra"

mkdir -p "${install_dir}/bin" "${install_dir}/libexec" "${install_dir}/lib" "${package_root}/usr/bin"
cp "${target_dir}/release/aaykra" "${install_dir}/libexec/aaykra-editor"
cp "${target_dir}/release/cli" "${install_dir}/bin/cli"
ln -s "/opt/aaykra/libexec/aaykra-editor" "${package_root}/usr/bin/aaykra"
ln -s "/opt/aaykra/bin/cli" "${package_root}/usr/bin/aaykra-cli"

find_libs() {
    ldd "${target_dir}/release/aaykra" |\
        cut -d' ' -f3 |\
        grep -v '\<\(libc.so\|libgcc_s.so\|libm.so\|libpthread.so\|libdl.so\|libasound.so\)' |\
        grep -v '\<\(libglib-2.0.so\|libgobject-2.0.so\|libgio-2.0.so\|libgmodule-2.0.so\|libpcre.so\|libpcre2-8.so\|libmount.so\|libblkid.so\|libselinux.so\|libffi.so\|libresolv.so\|libz.so\)'
}

mkdir -p "${install_dir}/lib"
cp $(find_libs) "${install_dir}/lib"

APP_NAME="AAYKRA"
APP_ID="me.aayush.Aaykra"
if [ "$channel" == "dev" ]; then
    APP_NAME="AAYKRA Dev"
    APP_ID="me.aayush.Aaykra-Dev"
fi

mkdir -p "${package_root}/usr/share/icons/hicolor/512x512/apps"
cp "crates/aaykra/resources/app-icon${suffix}.png" "${package_root}/usr/share/icons/hicolor/512x512/apps/aaykra.png"
cp "crates/aaykra/resources/app-icon${suffix}.png" "${package_root}/usr/share/icons/hicolor/512x512/apps/${APP_ID}.png"
mkdir -p "${package_root}/usr/share/icons/hicolor/1024x1024/apps"
cp "crates/aaykra/resources/app-icon${suffix}@2x.png" "${package_root}/usr/share/icons/hicolor/1024x1024/apps/aaykra.png"
cp "crates/aaykra/resources/app-icon${suffix}@2x.png" "${package_root}/usr/share/icons/hicolor/1024x1024/apps/${APP_ID}.png"

export DO_STARTUP_NOTIFY="true"
export APP_CLI="aaykra"
export APP_ICON="aaykra"
export APP_ARGS="%U"
export APP_NAME="${APP_NAME}"
export APP_ID="${APP_ID}"

mkdir -p "${package_root}/usr/share/applications"
envsubst < "crates/aaykra/resources/zed.desktop.in" > "${package_root}/usr/share/applications/${APP_ID}.desktop"
chmod +x "${package_root}/usr/share/applications/${APP_ID}.desktop"

if [ -f "assets/licenses.md" ]; then
    mkdir -p "${package_root}/usr/share/licenses/${package_name}"
    cp "assets/licenses.md" "${package_root}/usr/share/licenses/${package_name}/LICENSE"
fi

cat > "${package_root}/.PKGINFO" <<EOF
# Generated by script/bundle-arch
pkgname = ${package_name}
pkgbase = ${package_name}
pkgver = ${version}
pkgrel = ${pkgrel}
pkgdesc = A fast, native code editor built in Rust with a GPU-accelerated renderer
url = https://aayushhpokhrel.com.np
arch = ${pkg_arch}
license = GPL-3.0-or-later
license = Apache-2.0
depends = alsa-lib
depends = fontconfig
depends = glib2
depends = libva
depends = wayland
depends = libxcb
depends = libxkbcommon-x11
depends = openssl
depends = zstd
depends = sqlite
depends = libx11
depends = libxi
depends = libxcursor
optdepends = pipewire: screen sharing
optdepends = xdg-desktop-portal: screen sharing
optdepends = vulkan-driver: hardware acceleration
EOF

cat > "${package_root}/.INSTALL" <<'EOF'
post_install() {
    echo ">>> Updating icon cache..."
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -f -t /usr/share/icons/hicolor >/dev/null 2>&1 || true
    fi
    echo ">>> Updating desktop database..."
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database -q /usr/share/applications >/dev/null 2>&1 || true
    fi
}

post_upgrade() {
    post_install
}

post_remove() {
    post_install
}
EOF

build_mtree() {
    local root="$1"
    local out="$2"
    local exec_files=()
    local path rel entry size target mode sha time

    exec_files=(
        "./opt/aaykra/libexec/aaykra-editor"
        "./opt/aaykra/bin/cli"
        "./usr/share/applications/${APP_ID}.desktop"
    )

    # Entry format mirrors what makepkg emits via bsdtar --format=mtree:
    # type, uid, gid, mode, time, size and sha256 checksums.
    echo "#mtree" > "$out"
    while IFS= read -r path; do
        if [ "$path" = "." ]; then
            echo ". set type=dir uid=0 gid=0 mode=755" >> "$out"
            continue
        fi
        rel="${path#./}"
        time=$(stat -c %Y "$path")
        if [ -L "$path" ]; then
            target=$(readlink "$path")
            entry="./${rel} type=link link=${target} mode=777 time=${time}"
        elif [ -d "$path" ]; then
            entry="./${rel} type=dir uid=0 gid=0 mode=755 time=${time}"
        elif [ -f "$path" ]; then
            size=$(stat -c %s "$path")
            sha=$(sha256sum "$path" | cut -d' ' -f1)
            mode="644"
            case " ${exec_files[*]} " in
                *" ./${rel} "*)
                    mode="755"
                    ;;
            esac
            entry="./${rel} type=file uid=0 gid=0 mode=${mode} time=${time} size=${size} sha256=${sha}"
        else
            continue
        fi
        echo "${entry}" >> "$out"
    done < <(find "$root" | sort)
}

chmod 755 "${install_dir}/libexec/aaykra-editor" \
         "${install_dir}/bin/cli" \
         "${package_root}/usr/share/applications/${APP_ID}.desktop"

project_root="$(pwd)"
pushd "$package_root" > /dev/null
build_mtree . .MTREE

# makepkg writes .BUILDINFO for reproducibility; a minimal one keeps
# pacman/verification tools happy.
{
    echo "format = 1"
    echo "pkgname = ${package_name}"
    echo "pkgver = ${version}-${pkgrel}"
    echo "pkgarch = ${pkg_arch}"
    echo "builddate = $(date -u +%s)"
    echo "packager = Aayush Pokhrel <info@aayushhpokhrel.com.np>"
    echo "buildtool = script/bundle-arch"
    echo "buildtoolver = 1"
    echo "builddir = ${PWD}"
    echo "startdir = ${PWD}"
    echo "buildenv = CFLAGS=\"-O2 -pipe\""
    echo "buildenv = CPPFLAGS=\"-D_FORTIFY_SOURCE=2\""
    echo "buildenv = CXXFLAGS=\"-O2 -pipe\""
    echo "buildenv = LDFLAGS=\"-Wl,-O1 -Wl,--sort-common -Wl,--as-needed\""
    echo "buildenv = MAKEFLAGS=\"\""
} > .BUILDINFO

# .PKGINFO must be the first entry in the archive.
pkg_file="${project_root}/${target_dir}/release/${package_name}-${version}-${pkgrel}-${pkg_arch}.pkg.tar.zst"
tar --zstd -cf "${pkg_file}" .PKGINFO .BUILDINFO .MTREE .INSTALL opt usr
popd > /dev/null

echo "Built ${pkg_file}"
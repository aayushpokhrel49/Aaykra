#!/usr/bin/env bash

set -e

if ! command -v cargo-depgraph >/dev/null 2>&1; then
    cargo install cargo-depgraph
fi

graph_file=target/crate-graph.svg

cargo depgraph \
    --workspace-only \
    --offline \
    --root=aaykra,cli \
    --dedup-transitive-deps \
    | dot -Tsvg > "$graph_file"

echo "open $graph_file"
if command -v open >/dev/null 2>&1; then
    open "$graph_file"
elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$graph_file"
fi

cargo --config .cargo/bundle-config.toml build --release --target "${target_triple}" --package zed --package cli
>>>>>>> 2abf58ae93479ba0ebd02d357f3332c9d40baf50
# Build remote_server in separate invocation to prevent feature unification from other crates
# from influencing dynamic libraries required by it.
if [[ "$remote_server_triple" == "$musl_triple" ]]; then
    musl_cc_var="CC_$(echo "$remote_server_triple" | tr '-' '_')"
    export "$musl_cc_var"=musl-gcc
fi
cargo build --release --target "${remote_server_triple}" --package remote_server

# Split debug symbols into local .dbg files, then strip debug info and local
# symbols from the shipped binaries. Sentry receives the full unstripped
# binaries above; the .dbg files keep symbols recoverable when that upload
# is skipped.
# We use llvm-objcopy because GNU objcopy on older distros (e.g. Ubuntu 20.04)
# doesn't understand CREL sections produced by newer LLVM.
<<<<<<< 5a0780efc8eaf2484f8abfa16efc6194cfe72888
llvm-objcopy --strip-debug "${target_dir}/${target_triple}/release/aaykra"
llvm-objcopy --strip-debug "${target_dir}/${target_triple}/release/cli"
llvm-objcopy --strip-debug "${target_dir}/${remote_server_triple}/release/remote_server"
=======
llvm-objcopy --only-keep-debug "${target_dir}/${target_triple}/release/zed" "${target_dir}/${target_triple}/release/zed.dbg"
llvm-objcopy --only-keep-debug "${target_dir}/${remote_server_triple}/release/remote_server" "${target_dir}/${remote_server_triple}/release/remote_server.dbg"
llvm-objcopy --strip-debug --discard-all "${target_dir}/${target_triple}/release/zed"
llvm-objcopy --strip-debug --discard-all "${target_dir}/${target_triple}/release/cli"
llvm-objcopy --strip-debug --discard-all "${target_dir}/${remote_server_triple}/release/remote_server"
>>>>>>> 2abf58ae93479ba0ebd02d357f3332c9d40baf50

# Ensure that remote_server does not depend on libssl nor libcrypto, as we got rid of these deps.
if ldd "${target_dir}/${remote_server_triple}/release/remote_server" | grep -q 'libcrypto\|libssl'; then
    if [[ "$remote_server_triple" == *-musl ]]; then
        echo "Error: remote_server still depends on libssl or libcrypto" && exit 1
    else
        echo "Info: Using non-musl remote-server build."
    fi
fi

suffix=""
if [ "$channel" != "stable" ]; then
  suffix="-$channel"
fi

# Move everything that should end up in the final package
# into a temp directory.
temp_dir=$(mktemp -d)
app_dir="${temp_dir}/aaykra$suffix.app"

# Binary
mkdir -p "${app_dir}/bin" "${app_dir}/libexec"
cp "${target_dir}/${target_triple}/release/aaykra" "${app_dir}/libexec/aaykra-editor"
cp "${target_dir}/${target_triple}/release/cli" "${app_dir}/bin/aaykra"

# Libs
# Bundle libstdc++ so older supported systems can run binaries built with our
# toolchain even when their system libstdc++.so.6 lacks required GLIBCXX symbols.
#
# Never bundle the GLib family or its private dependencies: host libraries that
# get dlopen'd are built against the system GLib, and resolving them against an
# older bundled copy fails with missing symbols.
find_libs() {
    ldd ${target_dir}/${target_triple}/release/aaykra |\
        cut -d' ' -f3 |\
        grep -v '\<\(libc.so\|libgcc_s.so\|libm.so\|libpthread.so\|libdl.so\|libasound.so\)' |\
        grep -v '\<\(libglib-2.0.so\|libgobject-2.0.so\|libgio-2.0.so\|libgmodule-2.0.so\|libpcre.so\|libpcre2-8.so\|libmount.so\|libblkid.so\|libselinux.so\|libffi.so\|libresolv.so\|libz.so\)'
}

mkdir -p "${app_dir}/lib"
rm -rf "${app_dir}/lib/*"
cp $(find_libs) "${app_dir}/lib"

# App identity: the app ID doubles as the Wayland window ID, so an icon file
# named after it must be installed for compositors to show a window/taskbar icon.
APP_NAME="AAYKRA"
APP_ID="me.aayush.Aaykra"
if [[ "$channel" == "dev" ]]; then
  APP_NAME="AAYKRA Dev"
  APP_ID="me.aayush.Aaykra-Dev"
fi

# Icons. The generic `aaykra` name covers the desktop entry's
# `Icon=aaykra`; the app-id-named copy lets Wayland compositors resolve
# the window/taskbar icon (they look the icon up by the window's app_id).
mkdir -p "${app_dir}/share/icons/hicolor/512x512/apps"
cp "crates/aaykra/resources/app-icon$suffix.png" "${app_dir}/share/icons/hicolor/512x512/apps/aaykra.png"
cp "crates/aaykra/resources/app-icon$suffix.png" "${app_dir}/share/icons/hicolor/512x512/apps/${APP_ID}.png"
mkdir -p "${app_dir}/share/icons/hicolor/1024x1024/apps"
cp "crates/aaykra/resources/app-icon$suffix@2x.png" "${app_dir}/share/icons/hicolor/1024x1024/apps/aaykra.png"
cp "crates/aaykra/resources/app-icon$suffix@2x.png" "${app_dir}/share/icons/hicolor/1024x1024/apps/${APP_ID}.png"

# .desktop
export DO_STARTUP_NOTIFY="true"
export APP_CLI="aaykra"
export APP_ICON="aaykra"
export APP_ARGS="%U"
export APP_NAME="${APP_NAME}"
export APP_ID="${APP_ID}"

mkdir -p "${app_dir}/share/applications"
envsubst < "crates/aaykra/resources/zed.desktop.in" > "${app_dir}/share/applications/$APP_ID.desktop"
chmod +x "${app_dir}/share/applications/$APP_ID.desktop"

# Copy generated licenses so they'll end up in archive too
cp "assets/licenses.md" "${app_dir}/licenses.md"

# Create archive out of everything that's in the temp directory
arch=$(uname -m)
archive="aaykra-linux-${arch}.tar.gz"

rm -rf "${archive}"
remove_match="aaykra(-[a-zA-Z0-9]+)?-linux-$(uname -m)\.tar\.gz"
ls "${target_dir}/release" | grep -E ${remove_match} | xargs -d "\n" -I {} rm -f "${target_dir}/release/{}" || true
tar -czvf "${target_dir}/release/$archive" -C ${temp_dir} "aaykra$suffix.app"

gzip -f --stdout --best "${target_dir}/${remote_server_triple}/release/remote_server" > "${target_dir}/aaykra-remote-server-linux-${arch}.gz"
